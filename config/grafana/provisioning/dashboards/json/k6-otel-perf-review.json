{
  "uid": "k6-otel-perf-review",
  "title": "k6-otel-perf-review",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "k6: 完了したリクエストの頻度",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (testid) (rate(http_reqs_total{job=\"k6\", testid=~\"$testid\"}[30s]))",
          "legendFormat": "{{testid}}",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "k6のhttp_reqsは応答を受け取った時刻で記録される。送った頻度ではない"
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "k6: 応答時間のp(95)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, testid) (rate(http_req_duration_milliseconds_bucket{job=\"k6\", testid=~\"$testid\"}[30s])))",
          "legendFormat": "{{testid}}",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "ヒストグラムのバケットの中を補間した値。k6の要約のp(95)とは一致しない"
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "k6: 始められなかった反復（dropped_iterations）",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (testid) (rate(dropped_iterations_total{job=\"k6\", testid=~\"$testid\"}[30s]))",
          "legendFormat": "{{testid}}",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "k6: VUの数",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (testid) (vus{job=\"k6\", testid=~\"$testid\"})",
          "legendFormat": "vus {{testid}}",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        },
        {
          "refId": "B",
          "expr": "max by (testid) (vus_max{job=\"k6\", testid=~\"$testid\"})",
          "legendFormat": "vus_max {{testid}}",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "vusは反復を実行中のVU、vus_maxは初期化したVU"
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "サーバー側の処理時間のp(95)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_request_duration_seconds_bucket[30s])))",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "inventoryの待ち行列",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(inventory_queue_waiting)",
          "legendFormat": "待っている件数",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(inventory_queue_rejected_total[30s]))",
          "legendFormat": "503で断った頻度（件/秒）",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "catalog-apiで空きを待つ件数",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(catalog_limiter_waiting)",
          "legendFormat": "待っている件数",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "INSTRUMENT_WAIT=trueのときだけ記録される"
    }
  ],
  "tags": [
    "k6",
    "opentelemetry"
  ],
  "templating": {
    "list": [
      {
        "name": "testid",
        "label": "試験",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(http_reqs_total{job=\"k6\"}, testid)",
          "refId": "testid"
        },
        "definition": "label_values(http_reqs_total{job=\"k6\"}, testid)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  }
}